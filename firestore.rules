rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User lists - only the owner can access
      match /lists/{listId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Movies in lists - only the list owner can access
        match /movies/{movieId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      // Watch history - only the user can access
      match /watchHistory/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Public movie data (if you want to cache movie info)
    match /movieData/{movieId} {
      allow read: if true; // Anyone can read cached movie data
      allow write: if false; // Only functions can write movie data
    }
  }
}
